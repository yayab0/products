{% comment %}
  Homepage Featured Products Injection
  Replaces Shopify product data with server data on homepage/collections
  - Fetches all products from server
  - Updates product cards (title, price, images)
  - Works with any Shopify theme structure
{% endcomment %}

<script>
(function() {
  const SERVER_URL = 'https://products-7t0s.onrender.com';
  const SHOP_DOMAIN = '{{ shop.domain }}';
  const CACHE_KEY = 'homepage_products';
  const CACHE_TTL = 60000; // 60 seconds
  
  console.log('🏠 Homepage products injection starting...');
  
  // Wait for DOM to be fully ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  function init() {
    // Check if we're on a page with product listings
    const isProductListingPage = 
      document.querySelector('[data-product-id], .product-card, .product-grid, .collection-grid, .product-item') !== null;
    
    if (!isProductListingPage) {
      console.log('ℹ️ Not a product listing page, skipping injection');
      return;
    }
    
    console.log('✅ Found product listing page, loading products...');
    
    // Check cache
    const cached = sessionStorage.getItem(CACHE_KEY);
    if (cached) {
      try {
        const { data, timestamp } = JSON.parse(cached);
        if (Date.now() - timestamp < CACHE_TTL) {
          console.log('📦 Using cached homepage products');
          injectProducts(data);
          return;
        }
      } catch (e) {}
    }
    
    // Fetch all products from server
    fetch(`${SERVER_URL}/admin/products`)
      .then(res => res.ok ? res.json() : Promise.reject('Failed'))
      .then(response => {
        const products = response.products || response;
        
        // Filter out test products
        const realProducts = products.filter(p => 
          p.shopify_id !== '123' && 
          p.title && 
          p.handle
        );
        
        console.log(`✅ Loaded ${realProducts.length} products from server`);
        
        // Cache the data
        sessionStorage.setItem(CACHE_KEY, JSON.stringify({
          data: realProducts,
          timestamp: Date.now()
        }));
        
        injectProducts(realProducts);
      })
      .catch(err => console.error('❌ Failed to load products:', err));
  }
  
  function injectProducts(serverProducts) {
    // Create a map of Shopify ID to server product data
    const productMap = {};
    serverProducts.forEach(p => {
      productMap[p.shopify_id] = p;
    });
    
    console.log('📋 Product map created with IDs:', Object.keys(productMap));
    
    // Find ALL elements with data-product-id attribute
    const elementsWithProductId = document.querySelectorAll('[data-product-id]');
    console.log(`🔍 Found ${elementsWithProductId.length} elements with product IDs`);
    
    // Group by product card
    const processedCards = new Set();
    
    elementsWithProductId.forEach(element => {
      const shopifyId = element.getAttribute('data-product-id');
      
      if (!shopifyId || processedCards.has(shopifyId)) return;
      
      // Find the parent product card
      const card = element.closest('.product-card') || element;
      
      if (productMap[shopifyId]) {
        const serverData = productMap[shopifyId];
        console.log(`💉 Injecting data for ID ${shopifyId}: ${serverData.title}`);
        updateProductCard(card, serverData, shopifyId);
        processedCards.add(shopifyId);
      } else {
        console.warn(`⚠️ No server data found for product ID: ${shopifyId}`);
      }
    });
    
    console.log(`✅ Updated ${processedCards.size} product cards`);
  }
  
  function updateProductCard(card, data, shopifyId) {
    console.log(`  🔧 Updating card for: ${data.title.substring(0, 40)}...`);
    console.log(`     Images available: ${data.images ? data.images.length : 0}`);
    if (data.images && data.images.length > 0) {
      console.log(`     First image: ${data.images[0].substring(0, 60)}...`);
    }
    
    // Update ALL text nodes that contain the product ID
    const walker = document.createTreeWalker(
      card,
      NodeFilter.SHOW_TEXT,
      null,
      false
    );
    
    let node;
    let titleUpdated = false;
    while (node = walker.nextNode()) {
      if (node.textContent.includes(shopifyId)) {
        node.textContent = data.title;
        titleUpdated = true;
        console.log(`    ✓ Updated title via text node`);
      }
    }
    
    // Also try common title selectors
    if (!titleUpdated) {
      const titleSelectors = [
        `[class*="product_title"]`,
        `[class*="product-title"]`,
        `.product-card__title`,
        `.product-title`,
        `.product__title`,
        `h1, h2, h3, h4`,
        `a`,
      ];
      
      for (const selector of titleSelectors) {
        const titleEl = card.querySelector(selector);
        if (titleEl && titleEl.textContent.trim()) {
          titleEl.textContent = data.title;
          console.log(`    ✓ Updated title via selector: ${selector}`);
          titleUpdated = true;
          break;
        }
      }
    }
    
    // Update price - look for price elements
    const priceSelectors = [
      `.price`,
      `[class*="price"]`,
      `[data-price]`,
    ];
    
    for (const selector of priceSelectors) {
      const priceEls = card.querySelectorAll(selector);
      priceEls.forEach(priceEl => {
        // Check if it contains a price-like pattern
        if (priceEl.textContent.match(/[£$€]\s*\d/)) {
          priceEl.textContent = `$${data.price}`;
          console.log(`    ✓ Updated price: $${data.price}`);
        }
      });
    }
    
    // Update images - AGGRESSIVE REPLACEMENT
    if (data.images && data.images.length > 0) {
      const images = card.querySelectorAll('img');
      let imageCount = 0;
      images.forEach((img, idx) => {
        const imageUrl = data.images[idx % data.images.length]; // Cycle through available images
        if (imageUrl) {
          // Force replace all image attributes
          img.src = imageUrl;
          img.srcset = '';
          img.setAttribute('srcset', '');
          img.sizes = '';
          img.alt = data.title;
          
          // Remove lazy loading to show immediately
          img.loading = 'eager';
          img.removeAttribute('data-src');
          img.removeAttribute('data-srcset');
          
          // Force display
          img.style.opacity = '1';
          img.style.visibility = 'visible';
          
          imageCount++;
        }
      });
      console.log(`    ✓ Updated ${imageCount} images`);
    }
    
    // Update links to use correct handle
    if (data.handle) {
      const links = card.querySelectorAll('a[href*="/products/"]');
      links.forEach(link => {
        link.href = `/products/${data.handle}`;
      });
      console.log(`    ✓ Updated ${links.length} product links`);
    }
    
    // Visual feedback
    card.style.outline = '3px solid #00ff00';
    setTimeout(() => {
      card.style.outline = '';
    }, 2000);
  }
})();
</script>

<style>
/* Animation for injected products */
@keyframes productInjected {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 1; }
}

.product-injected {
  animation: productInjected 0.5s ease;
}
</style>

{% comment %}
  Product Schema + Visible Content Override (single-file)
  - Exposes product metadata for client scripts
  - Fetches server product JSON via App Proxy
  - Injects server JSON-LD and replaces visible fields for products tagged 'server-schema'
  CRITICAL: Place this AFTER Shopify's default schema script in the product template/section
{% endcomment %}

{% if template contains 'product' %}
  {% if product.tags contains 'server-schema' %}

  <div id="__product-proxy-data" style="display:none"
       data-product-id="{{ product.id }}"
       data-product-handle="{{ product.handle }}"
       data-product-tags="{{ product.tags | join: ',' }}"
       data-shop-domain="{{ shop.domain }}"></div>

  <script>
  (function(){
    // Read product data exposed by Liquid
    const metaEl = document.getElementById('__product-proxy-data');
    const PRODUCT_ID = metaEl ? metaEl.getAttribute('data-product-id') : '{{ product.id }}';
    const PROXY_PATH = '/apps/products';
    const SHOP_DOMAIN = metaEl ? metaEl.getAttribute('data-shop-domain') : '{{ shop.domain }}';

    // Expose a lightweight global hook
    try {
      window.__PRODUCT_PROXY = {
        id: PRODUCT_ID,
        handle: metaEl ? metaEl.getAttribute('data-product-handle') : '{{ product.handle }}',
        tags: metaEl ? (metaEl.getAttribute('data-product-tags')||'').split(',').filter(Boolean) : [],
        shop: SHOP_DOMAIN
      };
      window.dispatchEvent(new Event('product-proxy-ready'));
    } catch (e) { /* ignore */ }

    // STEP 1: Remove existing Shopify Product JSON-LD
    try {
      const allSchemas = document.querySelectorAll('script[type="application/ld+json"]');
      let removedCount = 0;
      allSchemas.forEach(script => {
        try {
          const data = JSON.parse(script.textContent);
          if (data['@type'] === 'Product' || (data['@id'] && String(data['@id']).includes('#product')) || (data['@graph'] && data['@graph'].some(item => item['@type'] === 'Product'))) {
            script.remove();
            removedCount++;
          }
        } catch (e) {}
      });
      if (removedCount > 0) console.log(`🗑️ Removed ${removedCount} Shopify Product schema(s)`);
    } catch (e) { /* ignore */ }

    if (!PRODUCT_ID) return;

    // STEP 2: Fetch server product data and inject schema + replace visible fields
    fetch(`https://${SHOP_DOMAIN}${PROXY_PATH}/product/${PRODUCT_ID}`)
      .then(res => res.ok ? res.json() : Promise.reject('Failed to fetch'))
      .then(data => {
        // Build JSON-LD
        const schema = {
          "@context": "https://schema.org/",
          "@type": "Product",
          "name": data.title || "Product",
          "description": data.description ? String(data.description).substring(0, 5000) : "",
          "sku": String(data.shopify_id || data.id || PRODUCT_ID),
          "brand": { "@type": "Brand", "name": "{{ shop.name }}" },
          "offers": { "@type": "Offer", "url": window.location.href, "priceCurrency": "USD", "price": String(data.price || "0"), "availability": "https://schema.org/InStock", "seller": { "@type": "Organization", "name": "{{ shop.name }}" } }
        };
        if (data.images && Array.isArray(data.images) && data.images.length) schema.image = data.images;

        const schemaScript = document.createElement('script');
        schemaScript.type = 'application/ld+json';
        schemaScript.id = 'server-product-schema';
        schemaScript.setAttribute('data-source', 'server');
        schemaScript.textContent = JSON.stringify(schema, null, 2);
        document.head.appendChild(schemaScript);
        console.log('✅ Server Product schema injected:', schema);

        // Replace visible product elements (best-effort with retries to cope with theme JS)
        try {
          const titleSelectors = ['.product__title','h1.product-title','h1.product-single__title','h1[class*="product"]','h1'];
          const priceSelectors = ['.price','.product__price','.product-single__price','[data-price]','.price-item--sale.price','.price-item__group .price','[data-testid="sticky-price-display"]'];
          const descSelectors = ['.product__description','.product-single__description','.product-description','[itemprop="description"]'];
          const imageSelectors = ['.product__media img','.product-single__photo img','.product__image img','picture img','img'];

          function replaceTitle() {
            for (const sel of titleSelectors) {
              const el = document.querySelector(sel);
              if (el && data.title) { el.textContent = data.title; console.log('✏️ Replaced title via', sel); return true; }
            }
            return false;
          }

          function replacePrice() {
            let did = false;
            const priceRegex = /[0-9]{1,3}(?:[\.,][0-9]{2})?/;
            for (const sel of priceSelectors) {
              const nodes = document.querySelectorAll(sel);
              nodes.forEach(el => {
                if (!el) return;
                const orig = el.textContent || '';
                if (!orig) return;
                const newNum = Number(data.price);
                if (isNaN(newNum)) return;
                const formatted = newNum.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
                if (priceRegex.test(orig)) {
                  const replaced = orig.replace(priceRegex, formatted);
                  if (replaced !== orig) {
                    el.textContent = replaced;
                    did = true;
                    console.log('✏️ Replaced price via', sel);
                  }
                } else {
                  // fallback: replace whole text
                  el.textContent = formatted;
                  did = true;
                }
              });
              if (did) return true;
            }
            return did;
          }

          function replaceDescription() {
            for (const sel of descSelectors) {
              const el = document.querySelector(sel);
              if (el && data.description) { el.innerHTML = data.description; console.log('✏️ Replaced description via', sel); return true; }
            }
            return false;
          }

          function replaceImage() {
            for (const sel of imageSelectors) {
              // handle picture > source + img
              const el = document.querySelector(sel);
              if (el && data.images && data.images.length > 0) {
                // if it's an <img>
                if (el.tagName && el.tagName.toLowerCase() === 'img') {
                  el.src = data.images[0];
                  el.srcset = '';
                  el.removeAttribute('loading');
                } else {
                  // try to find img inside
                  const img = el.querySelector && el.querySelector('img');
                  if (img) { img.src = data.images[0]; img.srcset = ''; img.removeAttribute('loading'); }
                }
                console.log('🖼️ Replaced main image via', sel);
                return true;
              }
            }
            return false;
          }

          let attempts = 0; const maxAttempts = 20;
          const interval = setInterval(() => {
            attempts++;
            const t = replaceTitle();
            const p = replacePrice();
            const d = replaceDescription();
            const i = replaceImage();
            if ((t && p && d && i) || attempts >= maxAttempts) {
              clearInterval(interval);
              console.log('🔁 Replacement attempts:', attempts, 'done');
            }
          }, 200);

        } catch (err) { console.warn('⚠️ Visible replacement failed', err); }

      })
      .catch(err => console.error('❌ Schema injection failed:', err));

  })();
  </script>

  {% endif %}
{% endif %}


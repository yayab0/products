{% comment %}
  Product Schema.org JSON-LD Override
  This removes Shopify's default Product schema and replaces it with server data
  CRITICAL: This must be placed AFTER Shopify's default schema in theme.liquid
{% endcomment %}

{% if template contains 'product' %}
{% if product.tags contains 'server-schema' %}
<script>
// STEP 1: Remove Shopify's Product schema immediately (before Google crawls)
(function() {
  // Remove existing Product schemas from the DOM
  const allSchemas = document.querySelectorAll('script[type="application/ld+json"]');
  let removedCount = 0;
  
  allSchemas.forEach(script => {
    try {
      const data = JSON.parse(script.textContent);
      // Remove if it's a Product schema (contains Shopify's wrong data)
      if (data['@type'] === 'Product' || 
          (data['@id'] && data['@id'].includes('#product')) ||
          (data['@graph'] && data['@graph'].some(item => item['@type'] === 'Product'))) {
        script.remove();
        removedCount++;
      }
    } catch (e) {
      // Skip invalid JSON
    }
  });
  
  if (removedCount > 0) {
    console.log(`🗑️ Removed ${removedCount} Shopify Product schema(s)`);
  }
})();

// STEP 2: Inject server Product schema
(function() {
  const PRODUCT_ID = '{{ product.id }}';
  const PROXY_PATH = '/apps/products';
  const SHOP_DOMAIN = '{{ shop.domain }}';
  
  if (!PRODUCT_ID) return;
  
  // Fetch server data and inject schema
  fetch(`https://${SHOP_DOMAIN}${PROXY_PATH}/product/${PRODUCT_ID}`)
    .then(res => res.ok ? res.json() : Promise.reject('Failed to fetch'))
    .then(data => {
      const schema = {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": data.title || "Product",
        "description": data.description ? data.description.substring(0, 5000) : "",
        "sku": String(data.shopify_id || data.id),
        "brand": {
          "@type": "Brand",
          "name": "{{ shop.name }}"
        },
        "offers": {
          "@type": "Offer",
          "url": window.location.href,
          "priceCurrency": "USD",
          "price": String(data.price || "0"),
          "availability": "https://schema.org/InStock",
          "seller": {
            "@type": "Organization",
            "name": "{{ shop.name }}"
          }
        }
      };
      
      // Add images if available
      if (data.images && Array.isArray(data.images) && data.images.length > 0) {
        schema.image = data.images;
      }
      
      // Inject new schema at the END of head (so it's the last one Google sees)
      const schemaScript = document.createElement('script');
      schemaScript.type = 'application/ld+json';
      schemaScript.id = 'server-product-schema';
      schemaScript.setAttribute('data-source', 'server');
      schemaScript.textContent = JSON.stringify(schema, null, 2);
      document.head.appendChild(schemaScript);
      
      console.log('✅ Server Product schema injected:', schema);

      // STEP 3: Replace visible product elements (title, price, description, image)
      try {
        // title selectors common across themes
        const titleSelectors = [
          '.product__title', 'h1.product-title', 'h1.product-single__title', 'h1[class*="product"]', 'h1' 
        ];
        const priceSelectors = [
          '.price', '.product__price', '.product-single__price', '[data-price]'
        ];
        const descSelectors = [
          '.product__description', '.product-single__description', '#ProductInfo-template--* .product__description', '.product-description'
        ];
        const imageSelectors = [
          '.product__media img', '.product-single__photo img', '.product__image img', 'img' 
        ];

        // Replace title
        for (const sel of titleSelectors) {
          const el = document.querySelector(sel);
          if (el && data.title) {
            el.textContent = data.title;
            console.log('✏️ Replaced title via', sel);
            break;
          }
        }

        // Replace price
        for (const sel of priceSelectors) {
          const el = document.querySelector(sel);
          if (el && data.price) {
            el.textContent = (data.price && !isNaN(Number(data.price))) ? Number(data.price).toFixed(2) : data.price;
            console.log('✏️ Replaced price via', sel);
            break;
          }
        }

        // Replace description
        for (const sel of descSelectors) {
          const el = document.querySelector(sel);
          if (el && data.description) {
            el.innerHTML = data.description;
            console.log('✏️ Replaced description via', sel);
            break;
          }
        }

        // Replace main image
        for (const sel of imageSelectors) {
          const el = document.querySelector(sel);
          if (el && data.images && data.images.length > 0) {
            el.src = data.images[0];
            el.srcset = '';
            console.log('🖼️ Replaced main image via', sel);
            break;
          }
        }
      } catch (err) {
        console.warn('⚠️ Visible content replacement failed:', err);
      }
    })
    .catch(err => console.error('❌ Schema injection failed:', err));
})();
</script>
{% endif %}
{% endif %}
</script>
{% endif %}

NODE_ENV=development
PORT=3000
SHOPIFY_APP_SECRET=your-shopify-app-secret-key-here

# Get this from your Shopify App settings:
# 1. Go to Shopify Admin → Settings → Apps and sales channels
# 2. Click "Develop apps"
# 3. Create or select your app
# 4. Go to "API credentials"
# 5. Copy the "API secret key"
